{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberNaiwa",
  "version": "0.2.3",
  "identifier": "com.cybernaiwa.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "title": "赛博奶蛙",
        "width": 380,
        "height": 420,
        "minWidth": 266,
        "minHeight": 294,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visible": false,
        "theme": "Dark"
      },
      {
        "label": "settings",
        "title": "赛博奶蛙 设置",
        "width": 520,
        "height": 760,
        "minWidth": 480,
        "minHeight": 700,
        "resizable": false,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "capabilities": ["pet", "settings"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CyberNaiwa contributors",
    "category": "Utility",
    "shortDescription": "赛博奶蛙 · 让奶娃住进每个奶家人的电脑",
    "longDescription": "赛博奶蛙是本地运行的桌面宠物：成年/幼体奶蛙、原色模式/量子模式、五态动画和奶蛙语音。设置保存在本地 JSON，不需要账号或网络。",
    "copyright": "Copyright © 2026 CyberNaiwa contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "nsis/theme.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

